#include<iostream>
using namespace std;

int rs(int arr[], int start, int end, int search)
{
    if(start > end)
    {
        return -1;
    }

    int mid = start + (end - start) / 2;

    if(arr[mid] == search)
    {
        return mid;
    }
    else if(search > arr[mid])
    {
        return rs(arr, mid + 1, end, search);
    }
    else
    {
        return rs(arr, start, mid - 1, search);
    }
}

int main()
{
    cout<<"Enter Number of Books : ";
    int n;
    cin>>n;

    int arr[n];

    cout<<"Enter Book IDs : "<<endl;
    for(int i=0; i<n; i++)
    {
        cin>>arr[i];
    }

    cout<<"Sorted Book IDs : ";
    for(int i=0; i<n-1; i++)
    {
        for(int j=0; j<n-i-1; j++)
        {
            if(arr[j] > arr[j+1])
            {
                int temp = arr[j];
                arr[j] = arr[j+1];
                arr[j+1] = temp;
            }
        }
    }

    for(int i=0; i<n; i++)
    {
        cout<<arr[i]<<" ";
    }

    int search;
    cout<<"\nEnter ID want to search : ";
    cin>>search;

    int position = rs(arr, 0, n-1, search);

    if(position != -1)
    {
        cout<<"Book found at position : "<<position + 1;
    }
    else
    {
        cout<<"Book ID "<<search<<" not found.";
    }

    return 0;
}
