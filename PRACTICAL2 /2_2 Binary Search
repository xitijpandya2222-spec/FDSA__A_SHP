#include<iostream>
using namespace std;
int main()
{
    cout<<"Enter Number of Books : ";
    int n ;
    cin>>n;
    int arr[n];
    cout<<"Enter Book IDs : "<<endl;
    for(int i=0 ; i<n ;i++)
    {
        cin>>arr[i];
    }
    cout<<"Sorted Bookd IDs : ";
    for(int i = 0; i < n - 1; i++)
    {
        for(int j = 0; j < n - i - 1; j++)
        {
            if(arr[j] > arr[j + 1])
            {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }   
    }
    for(int i = 0 ; i <n ; i++)
    {
        cout<<arr[i]<<" ";
    }
    int start = 0 ;
    int end = n-1 ;
    int search ;
    cout<<"\nEnter ID want to search : ";
    cin>>search;
    bool b = false ;
    int mid ;
    while(start<=end)
    {
        mid = start+((end-start)/2);
        if(search==arr[mid])
        {
             b = true ;
             break ;
        }
        else if(search>arr[mid])
        {
            start  = mid + 1 ;
        }
        else if (search < arr[mid])
        {
            end = mid - 1 ;
        }
    }
    if (b==true)
    {
        cout << "Book found at position : " << mid + 1;    }
    else{
        cout<<"Book is ID "<<search<<" not found : "<<endl;
    }
}
