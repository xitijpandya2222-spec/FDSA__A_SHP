#include<iostream>
#include<string>
#include<vector>
using namespace std;
int main()
{
    int n;
    cout<<"Number of Vehicals : ";
    cin>>n;
    vector<string> arr(n);
    cout<<"Enter all car plate numbers : "<<endl;
    for(int i=0 ; i<n ; i++)
    {
        cout<<"Enter "<<i+1<<" Car Plate Number : ";
        cin>>arr[i];
    }
    string targetplate = "null";
    bool b=false;
    cout<<"enter target plate number : ";
    cin>>targetplate;
    for(int i=0;i<n;i++)
    {
        if(arr[i].compare(targetplate)==0)
        {
            cout<<"Position of Target plate is : "<<i+1<<endl;
            b = true;
            break;
        }
        
    }
    if(b==false)
    {
        cout<<"No car found !!";
    }
    return 0;
}    
