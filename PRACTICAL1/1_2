#include<iostream>
using namespace std;

int main()
{
    int n;
    cout<<"Enter number books borrowed : ";
    cin>>n;

    int a[n];
    cout<<"Enter all borrowed books id : "<<endl;

    for(int i=0;i<n;i++)
    {
        cin>>a[i];
    }

    cout<<"Books borrowed more than one : "<<endl;

    for(int i=0;i<n;i++)
    {
        int count = 0;

        for(int k=0;k<i;k++)
        {
            if(a[k]==a[i])
            {
                count++;
            }
        }

        if(count==0)
        {
            for(int j=i+1;j<n;j++)
            {
                if(a[j]==a[i])
                {
                    cout<<a[i]<<endl;
                    break;
                }
            }
        }
    }

    return 0;
}
